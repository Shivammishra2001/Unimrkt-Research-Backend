      "maxLength": 120
    },
    "subheading": {
      "type": "string",
      "maxLength": 160
    },
    "description": {
      "type": "text",
      "maxLength": 320
    },
    "items": {
      "type": "component",
      "component": "blocks.feature-item",
      "repeatable": true,
      "required": true,
      "min": 2,
      "max": 12
    },
    "theme": {
      "type": "enumeration",
      "enum": ["light", "dark", "accent"],
      "default": "light"
    },
    "anchorId": {
      "type": "string",
      "regex": "^[a-z0-9-]+$"
    }
  }
