{
  "collectionName": "components_blocks_why_choose_us",
  "info": {
    "displayName": "Why Choose Us",
    "icon": "star",
    "description": "Differentiator cards with an optional stat — Figma node 617:7561. Cards reuse blocks.feature-item (extended with statValue/statLabel/order) rather than a duplicate component."
