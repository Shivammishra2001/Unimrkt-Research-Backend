{
  "collectionName": "components_blocks_feature_grids",
  "info": {
    "displayName": "Feature Grid",
    "icon": "grid"
  },
  "attributes": {
    "heading": {
      "type": "string",
      "maxLength": 120
    },
    "subheading": {
      "type": "text",
      "maxLength": 280
    },
    "columns": {
      "type": "enumeration",
      "enum": ["2", "3", "4"],
      "required": true,
      "default": "3"
    },
    "items": {
      "type": "component",
      "component": "blocks.feature-item",
      "repeatable": true,
      "required": true,
      "min": 2,
      "max": 12
    },
    "theme": {
      "type": "enumeration",
      "enum": ["light", "dark"],
      "default": "light"
    },
    "anchorId": {
      "type": "string",
      "regex": "^[a-z0-9-]+$"
    }
  }
}
