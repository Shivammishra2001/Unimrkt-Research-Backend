{
  "collectionName": "components_blocks_heroes",
  "info": {
    "displayName": "Hero",
    "icon": "layout"
  },
  "attributes": {
    "eyebrow": {
      "type": "string",
      "maxLength": 60
    },
    "heading": {
      "type": "string",
      "required": true,
      "maxLength": 120
    },
    "subheading": {
      "type": "text",
      "maxLength": 280
    },
    "media": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images", "videos"]
    },
    "mediaAlignment": {
      "type": "enumeration",
      "enum": ["right", "left", "below", "background"],
      "required": true,
      "default": "right"
    },
    "actions": {
      "type": "component",
      "component": "shared.link",
      "repeatable": true,
      "max": 2
    },
    "sideMenu": {
      "type": "component",
      "component": "blocks.service-band-item",
      "repeatable": true,
      "max": 10
    },
    "headingSize": {
      "type": "enumeration",
      "enum": ["display", "h2"],
      "default": "display"
    },
    "statValue": {
      "type": "string",
      "maxLength": 20
    },
    "statLabel": {
      "type": "string",
      "maxLength": 60
    },
    "theme": {
      "type": "enumeration",
      "enum": ["light", "dark"],
      "default": "light"
    },
    "anchorId": {
      "type": "string",
      "regex": "^[a-z0-9-]+$"
    }
  }
}
