{
  "collectionName": "components_blocks_feature_items",
  "info": {
    "displayName": "Feature Item",
    "icon": "check"
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 80
    },
    "description": {
