{
  "collectionName": "components_blocks_industry_items",
  "info": {
    "displayName": "Industry Item",
    "icon": "globe"
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 200
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images", "videos", "files"]
    },
    "description": {
      "type": "text"
    },
    "accentColor": {
      "type": "string",
      "default": "#7f3856",
      "regex": "^#[0-9a-fA-F]{6}$"
    }
  }
}
