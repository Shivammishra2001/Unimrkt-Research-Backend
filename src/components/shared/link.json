{
  "collectionName": "components_shared_links",
  "info": {
    "displayName": "Link",
    "icon": "link"
  },
  "attributes": {
    "label": {
      "type": "string",
      "required": true,
      "maxLength": 40
    },
    "href": {
      "type": "string",
      "required": true
    },
    "isExternal": {
