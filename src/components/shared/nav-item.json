{
  "collectionName": "components_shared_nav_items",
  "info": {
    "displayName": "Nav Item",
    "icon": "bulletList"
  },
  "attributes": {
    "label": {
      "type": "string",
      "required": true,
      "maxLength": 40
    },
    "menuType": {
      "type": "enumeration",
      "enum": [
        "link",
        "dropdown",
        "services_mega_menu",
        "industries_mega_menu"
      ],
      "default": "link"
    },
    "page": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::page.page"
    },
    "href": {
      "type": "string",
      "required": false
    },
    "isExternal": {
      "type": "boolean",
      "default": false
    },
    "isVisible": {
      "type": "boolean",
      "default": true
    },
    "children": {
      "type": "component",
      "component": "shared.nav-child-item",
      "repeatable": true,
      "max": 8
    },
    "showIndicator": {
      "type": "boolean",
      "default": false
    }
  }
}
