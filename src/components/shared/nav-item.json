{
  "collectionName": "components_shared_nav_items",
  "info": {
    "displayName": "Nav Item",
    "icon": "bulletList"
  },
  "attributes": {
    "label": {
      "type": "string",
      "required": true,
      "maxLength": 40
    },
    "href": {
      "type": "string",
      "required": true
    },
    "isExternal": {
      "type": "boolean",
      "default": false
    },
    "children": {
      "type": "component",
      "component": "shared.nav-child-item",
      "repeatable": true,
      "max": 8
    },
    "showIndicator": {
      "type": "boolean",
      "default": false
    }
  }
}
