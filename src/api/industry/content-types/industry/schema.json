{
  "kind": "collectionType",
  "collectionName": "industries",
  "info": {
    "singularName": "industry",
    "pluralName": "industries",
    "displayName": "Industries",
    "description": "A single industry vertical — listed at /industries, detailed at /industries/:slug"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 120
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "unique": true
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "required": false
    },
    "legacyUrl": {
      "type": "string",
      "required": false
    },
    "suggestedUrl": {
      "type": "string",
      "required": false
    },
    "summary": {
      "type": "text",
      "maxLength": 280
    },
    "icon": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "videos",
        "files"
      ]
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "industry-sections.hero",
        "industry-sections.overview",
        "industry-sections.why-research",
        "industry-sections.expertise",
        "industry-sections.challenges",
        "industry-sections.who-we-serve",
        "industry-sections.methodologies",
        "industry-sections.empower",
        "industry-sections.enquiry",
        "industry-sections.blogs-band",
        "industry-sections.faq",
        "industry-sections.case-studies",
        "industry-sections.about",
        "industry-sections.cta-banner",
        "shared.seo"
      ]
    }
  }
}
