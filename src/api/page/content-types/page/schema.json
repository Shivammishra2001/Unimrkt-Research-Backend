{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Pages",
    "description": "Any routable page — home, about, or a nested section like services/cloud"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 120
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "unique": true
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    },
    "blocks": {
      "type": "dynamiczone",
      "components": [
        "blocks.hero",
        "blocks.service-band",
        "blocks.stats-band",
        "blocks.industry-grid",
        "blocks.content",
        "blocks.media-gallery",
        "blocks.blog-teaser",
        "blocks.faq",
        "blocks.cta",
        "blocks.feature-grid",
        "blocks.testimonials",
        "blocks.why-choose-us",
        "blocks.process-steps",
        "page-content.our-company",
        "page-content.work-with-us",
        "page-content.case-study",
        "page-content.contact",
        "page-content.our-team",
        "page-content.privacy-policy",
        "industries-page.hero",
        "industries-page.intro",
        "industries-page.grid",
        "industries-page.beyond",
        "industries-page.band",
        "industries-page.insights",
        "industries-page.cases",
        "industries-page.reach",
        "industries-page.process",
        "industries-page.testimonials",
        "industries-page.faq",
        "industries-page.about",
        "industries-page.final-cta"
      ],
      "required": true,
      "min": 1
    }
  }
}
