{
  "kind": "collectionType",
  "collectionName": "gallery_items",
  "info": {
    "singularName": "gallery-item",
    "pluralName": "gallery-items",
    "displayName": "Media Gallery Items",
    "description": "A single photo in the /gallery page's grid, editable from the CMS instead of the static fixture it replaces."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 120
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "Team & Culture",
        "Research Process",
        "Field Work",
        "Client Interactions",
        "Events & Conferences"
      ],
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "caption": {
      "type": "text"
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  }
}
