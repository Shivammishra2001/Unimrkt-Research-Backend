{
  "kind": "singleType",
  "collectionName": "globals",
  "info": {
    "singularName": "global",
    "pluralName": "globals",
    "displayName": "Global Header, Footer & SEO",
    "description": "Site-wide navigation, footer and SEO defaults"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "siteName": {
      "type": "string",
      "required": true,
      "maxLength": 60
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "videos",
        "files"
      ]
    },
    "logoDark": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "videos",
        "files"
      ]
    },
    "primaryNav": {
      "type": "component",
      "component": "shared.nav-item",
      "repeatable": true,
      "max": 8
    },
    "navCta": {
      "type": "component",
      "component": "shared.link",
      "repeatable": false
    },
    "servicesMenu": {
      "type": "component",
      "component": "navigation.services-menu",
      "repeatable": false
    },
    "industriesMenu": {
      "type": "component",
      "component": "navigation.industries-menu",
      "repeatable": false
    },
    "blogBand": {
      "type": "component",
      "component": "shared.blog-band",
      "repeatable": false
    },
    "faqBand": {
      "type": "component",
      "component": "shared.faq-band",
      "repeatable": false
    },
    "finalCta": {
      "type": "component",
      "component": "shared.final-cta",
      "repeatable": false
    },
    "footerBadges": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "footerColumns": {
      "type": "component",
      "component": "shared.footer-column",
      "repeatable": true,
      "max": 4
    },
    "socialHeading": {
      "type": "string",
      "maxLength": 60
    },
    "socialLinks": {
      "type": "component",
      "component": "shared.link",
      "repeatable": true
    },
    "copyright": {
      "type": "string",
      "maxLength": 200
    },
    "footerTagline": {
      "type": "text",
      "maxLength": 200
    },
    "chatWidget": {
      "type": "component",
      "component": "shared.chat-widget",
      "repeatable": false
    },
    "defaultSeo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "required": true
    }
  }
}
