{
  "kind": "collectionType",
  "collectionName": "cities",
  "info": {
    "singularName": "city",
    "pluralName": "cities",
    "displayName": "City",
    "description": "A serviceable city — the location half of a /services/:city/:service page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 80
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "unique": true
    },
    "region": {
      "type": "string",
      "maxLength": 80
    },
    "localMeta": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
