{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "Service Detail Pages",
    "description": "A single service offering — listed at /services, detailed at /services/:slug"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 120
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "unique": true
    },
    "summary": {
      "type": "text",
      "required": true,
      "maxLength": 280
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "features": {
      "type": "component",
      "component": "blocks.feature-item",
      "repeatable": true,
      "max": 12
    },
    "basePrice": {
      "type": "string",
      "maxLength": 40
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    },
    "parent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::service.service",
      "inversedBy": "children"
    },
    "children": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::service.service",
      "mappedBy": "parent"
    },
    "legacyUrl": {
      "type": "string",
      "required": false
    },
    "suggestedUrl": {
      "type": "string",
      "required": false
    },
    "heroEyebrow": {
      "type": "string",
      "maxLength": 60
    },
    "heroHeading": {
      "type": "string",
      "maxLength": 120
    },
    "heroSubheading": {
      "type": "text",
      "maxLength": 280
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "heroActions": {
      "type": "component",
      "component": "shared.link",
      "repeatable": true,
      "max": 2
    },
    "trustHeading": {
      "type": "string",
      "maxLength": 80
    },
    "trustLogos": {
      "type": "component",
      "component": "industries.trust-logo",
      "repeatable": true,
      "max": 8
    },
    "overviewEyebrow": {
      "type": "string",
      "maxLength": 60
    },
    "overviewHeading": {
      "type": "string",
      "maxLength": 120
    },
    "overviewBody": {
      "type": "text",
      "maxLength": 2000
    },
    "overviewImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "overviewFeatures": {
      "type": "component",
      "component": "industries.detail-card",
      "repeatable": true,
      "max": 4
    },
    "capabilitiesEyebrow": {
      "type": "string",
      "maxLength": 60
    },
    "capabilitiesHeading": {
      "type": "string",
      "maxLength": 120
    },
    "capabilitiesBody": {
      "type": "text",
      "maxLength": 400
    },
    "credentialsHeading": {
      "type": "string",
      "maxLength": 120
    },
    "credentialsBody": {
      "type": "text",
      "maxLength": 400
    },
    "credentials": {
      "type": "component",
      "component": "services.stat-item",
      "repeatable": true,
      "max": 16
    },
    "methodologiesEyebrow": {
      "type": "string",
      "maxLength": 60
    },
    "methodologiesHeading": {
      "type": "string",
      "maxLength": 120
    },
    "methodologies": {
      "type": "component",
      "component": "industries.detail-card",
      "repeatable": true,
      "max": 6
    },
    "industriesEyebrow": {
      "type": "string",
      "maxLength": 60
    },
    "industriesHeading": {
      "type": "string",
      "maxLength": 120
    },
    "industriesBody": {
      "type": "text",
      "maxLength": 400
    },
    "industriesServed": {
      "type": "component",
      "component": "industries.detail-card",
      "repeatable": true,
      "max": 12
    },
    "enquiryEyebrow": {
      "type": "string",
      "maxLength": 60
    },
    "enquiryHeading": {
      "type": "string",
      "maxLength": 120
    },
    "enquiryBody": {
      "type": "text",
      "maxLength": 400
    },
    "enquiryImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "faqItems": {
      "type": "component",
      "component": "blocks.faq-item",
      "repeatable": true,
      "max": 10
    },
    "aboutEyebrow": {
      "type": "string",
      "maxLength": 60
    },
    "aboutHeading": {
      "type": "string",
      "maxLength": 120
    },
    "aboutBody": {
      "type": "text",
      "maxLength": 2000
    }
  }
}
