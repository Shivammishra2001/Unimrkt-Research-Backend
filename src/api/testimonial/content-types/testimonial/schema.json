{
  "kind": "collectionType",
  "collectionName": "testimonials",
  "info": {
    "singularName": "testimonial",
    "pluralName": "testimonials",
    "displayName": "Client Testimonials & Quotes"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "quote": {
      "type": "text",
      "required": true,
      "maxLength": 320
    },
    "authorName": {
      "type": "string",
      "required": true,
      "maxLength": 80
    },
    "authorRole": {
      "type": "string",
      "maxLength": 120
    },
    "company": {
      "type": "string",
      "maxLength": 80
    },
    "avatar": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "companyLogo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "rating": {
      "type": "integer",
      "min": 1,
      "max": 5,
      "default": 5
    },
    "featured": {
      "type": "boolean",
      "default": false
    }
  }
}
