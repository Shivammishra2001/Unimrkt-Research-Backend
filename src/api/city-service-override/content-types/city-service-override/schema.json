{
  "kind": "collectionType",
  "collectionName": "city_service_overrides",
  "info": {
    "singularName": "city-service-override",
    "pluralName": "city-service-overrides",
    "displayName": "City Service Override",
    "description": "City-specific overrides for one (city, service) pair. Every field is optional — an unset field falls back to the master api::service.service entry at merge time."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "city": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::city.city",
      "required": true
    },
    "service": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::service.service",
      "required": true
    },
    "overrideTitle": {
      "type": "string",
      "maxLength": 160
    },
    "overrideSummary": {
      "type": "text",
      "maxLength": 280
    },
    "customPrice": {
      "type": "string",
      "maxLength": 40
    },
    "overrideBlocks": {
      "type": "dynamiczone",
      "components": [
        "blocks.hero",
        "blocks.content",
        "blocks.feature-grid",
        "blocks.testimonials",
        "blocks.cta"
      ]
    },
    "localPhone": {
      "type": "string",
      "maxLength": 30
    },
    "localAddress": {
      "type": "text",
      "maxLength": 240
    },
    "overrideSeo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
