HOST=0.0.0.0
PORT=1337

# Public base URL this server is actually reached at (e.g. behind an nginx
# reverse proxy on a domain). Baked into the admin panel's client bundle at
# `strapi build` time as its API base — leave unset for local dev, where
# Strapi's own host/port default is already correct.
PUBLIC_URL=

# Path the admin panel is served at (requires `npm run build` to take effect)
ADMIN_PATH=/unimrktadmin

# Generate each with: openssl rand -base64 32
APP_KEYS="key1,key2,key3,key4"
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

DATABASE_CLIENT=sqlite
# Keep this outside dist/ — config/database.ts resolves it relative to the
# COMPILED config file (dist/config), and both `strapi build` and
# `strapi develop` clean the whole dist/ dir on every run. `.tmp/data.db`
# would resolve to dist/.tmp/data.db and get wiped on every rebuild.
DATABASE_FILENAME=../data/data.db

# Postgres (production) — set DATABASE_CLIENT=postgres and fill these in
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=headless_cms
DATABASE_USERNAME=cms_user
DATABASE_PASSWORD=
DATABASE_SSL=false
# Fallback-only (sane defaults in config/database.ts; override for a
# production Postgres deploy that needs different values)
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT=60000

# Admin panel feature flags (fallback-only — default true in config/admin.ts)
FLAG_NPS=true
FLAG_PROMOTE_EE=true

# Where the frontend lives — used by the revalidation webhook
FRONTEND_URL=http://localhost:3000
REVALIDATE_SECRET=
PREVIEW_SECRET=
